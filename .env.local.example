# Salin berkas ini menjadi `.env.local`, lalu isi nilainya.
# `.env.local` tidak ikut ter-commit (lihat .gitignore).

# API key DeepSeek — dibuat di https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Model termurah: deepseek-flash (DeepSeek-V4.1-Flash)
# Alternatif: deepseek-v4-pro (lebih mahal, lebih kuat)
DEEPSEEK_MODEL=deepseek-flash

# Opsional — hanya bila memakai gateway/proxy sendiri
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== OpenRouter (cadangan otomatis bila DeepSeek gagal/habis) =====
# Dibuat di https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model berbayar termurah — dipakai lebih dulu karena paling andal
OPENROUTER_CHEAP_MODEL=mistralai/mistral-nemo
# Set "true" bila ingin mencoba model gratis lebih dulu (sering kena 429)
OPENROUTER_PREFER_FREE=false
